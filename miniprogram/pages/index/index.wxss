.home { background: radial-gradient(circle at 75% 16%, #e8e3fb 0, #f4f3fa 38%); display: flex; flex-direction: column; }.topbar { height: 90rpx; }.brand { font-size: 32rpx; font-weight: 800; letter-spacing: 3rpx; }.moon { color: #7359ca; font-size: 44rpx; margin-right: 12rpx; }.profile { color: #a7a9b1; font-size: 25rpx; gap: 16rpx; }.avatar { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; border-radius: 50%; background: #eee7fa; color: #7359ca; }.hero { margin-top: 100rpx; }.hero .title { max-width: 600rpx; }.hero .subtitle { max-width: 560rpx; }.resume { margin-top: 54rpx; display: flex; align-items: center; justify-content: space-between; border-left: 5rpx solid #7359ca; }.resume-label { color: #888c98; font-size: 23rpx; }.resume-code { font-size: 32rpx; font-weight: 700; margin-top: 8rpx; }.resume-actions { display: flex; align-items: center; gap: 24rpx; }.exit-room { color: #d18282; font-size: 23rpx; padding: 18rpx 6rpx; }.arrow { font-size: 48rpx; color: #7359ca; }.actions { margin-top: auto; display: grid; gap: 20rpx; padding-top: 60rpx; }.features { display: flex; justify-content: space-around; margin: 48rpx 0 38rpx; }.feature { color: #777b87; display: flex; flex-direction: column; align-items: center; font-size: 22rpx; gap: 10rpx; }.icon { font-size: 36rpx; color: #8a69c9; }.tip { text-align: center; color: #96889f; font-size: 21rpx; }
.home-hero { margin-top: 56rpx; text-align: center; padding: 42rpx 20rpx; }
.hero-moon { width: 146rpx; height: 146rpx; line-height: 146rpx; border-radius: 46rpx; margin: 0 auto 28rpx; font-size: 82rpx; color: #8564dc; background: #eae3fc; box-shadow: 0 12rpx 40rpx rgba(128,91,198,.1); }
.home-hero .title { font-size: 43rpx; }
.home-features { display: flex; justify-content: center; gap: 14rpx; margin-top: 28rpx; }
.home-features view { font-size: 21rpx; padding: 10rpx 17rpx; background: #fff; border: 1rpx solid #e7e0f1; border-radius: 999rpx; color: #8d769d; }
.home .actions { padding-top: 36rpx; }
.test-users { margin-top: 28rpx; }.test-users .section-title { font-size: 25rpx; }.test-users .muted { font-size: 22rpx; line-height: 1.7; }.test-users button { margin-top: 20rpx; }
.resume-main { display: flex; min-width: 0; width: 100%; height: auto; min-height: 104rpx; box-sizing: border-box; align-items: center; justify-content: space-between; gap: 16rpx; padding: 8rpx 12rpx 8rpx 0; margin: 0; border-radius: 0; text-align: left; background: transparent; line-height: 1.5; white-space: normal; }
.resume { display: grid; grid-template-columns: minmax(0, 1fr) 112rpx; gap: 16rpx; padding: 22rpx 22rpx 22rpx 14rpx; }
.resume-info { flex: 1; min-width: 0; }.resume-label { line-height: 1.5; overflow-wrap: break-word; }.resume-code { line-height: 1.5; overflow-wrap: break-word; }
.resume-main .arrow { flex: 0 0 40rpx; width: 40rpx; text-align: center; }
.resume .exit-room { flex: 0 0 112rpx; width: 112rpx; height: 88rpx; min-width: 0; padding: 0; margin: 0; line-height: 88rpx; font-size: 25rpx; border-radius: 22rpx; background: #fae9ee; color: #b64f67; }
