.game { position: relative; overflow: visible; }.game.night { background: radial-gradient(circle at 50% 24%, #e9e3fb 0, #f4f3fa 45%); }.game.day { background: radial-gradient(circle at 70% 10%, #eee8fb 0, #f4f3fa 45%); }.game-head { height: 100rpx; }.day-count { font-weight: 700; font-size: 32rpx; margin-top: 5rpx; }.game-head .row { gap: 14rpx; }.note-btn { width: 68rpx; height: 68rpx; line-height: 68rpx; text-align: center; border-radius: 50%; background: #262933; color: #7359ca; font-size: 30rpx; }.center { text-align: center; margin-top: 110rpx; }.pass-icon { margin: auto; width: 160rpx; height: 160rpx; line-height: 160rpx; border-radius: 50%; border: 1rpx solid #c8b9ee; color: #7359ca; background: #ede7fb; font-size: 70rpx; }.focus-title { font-size: 48rpx; font-weight: 800; margin-top: 35rpx; }.focus-sub { color: #8d909b; font-size: 26rpx; margin: 18rpx auto; line-height: 1.65; max-width: 580rpx; }.role-card { margin: 32rpx auto; width: 560rpx; padding: 36rpx; box-sizing: border-box; border-radius: 24rpx; background: #ffffff; border: 1rpx solid #e4dced; }.role-name { color: #7359ca; font-size: 52rpx; font-weight: 800; }.role-desc { color: #aaa79e; font-size: 25rpx; line-height: 1.7; margin-top: 18rpx; }.bottom-action { position: fixed; left: 32rpx; right: 32rpx; bottom: calc(40rpx + env(safe-area-inset-bottom)); }.broadcast { display: flex; align-items: center; margin-top: 28rpx; gap: 20rpx; }.sound { color: #7359ca; font-size: 38rpx; }.broadcast-text { font-size: 26rpx; font-weight: 700; }.broadcast .muted { font-size: 20rpx; margin-top: 7rpx; }.replay { margin-left: auto; color: #7359ca; font-size: 22rpx; }.operator { text-align: center; color: #858995; font-size: 25rpx; margin: 36rpx 0 20rpx; }.operator text { color: #7359ca; font-weight: 700; }.action-panel { max-height: none; overflow: visible; }.targets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }.target { padding: 18rpx 8rpx; border: 1rpx solid #ddd6e9; border-radius: 16rpx; text-align: center; color: #62576f; }.target.selected { border-color: #7359ca; background: #eee6fb; color: #7359ca; }.target.dead { opacity: .25; text-decoration: line-through; }.target-name { display: block; color: #777b87; font-size: 19rpx; margin-top: 5rpx; }.witch-actions { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #e4dced; }.witch-tip { font-size: 21rpx; margin-top: 12rpx; }.check-result { padding: 20rpx; margin-top: 20rpx; border-radius: 14rpx; background: #eee6fb; text-align: center; }.check-result text { color: #7359ca; font-weight: 700; }.dawn { margin-top: 180rpx; }.sun { font-size: 130rpx; color: #8762d5; text-shadow: 0 0 60rpx rgba(109,91,215,.16); }.sun.small { font-size: 70rpx; margin-right: 25rpx; }.day-banner { display: flex; align-items: center; margin: 50rpx 0 35rpx; }.day-banner .focus-title { font-size: 36rpx; margin: 0; }.day-banner .focus-sub { margin: 5rpx 0; font-size: 22rpx; }.player-list { max-height: 600rpx; overflow-y: auto; }.player-row { padding: 16rpx 0; border-bottom: 1rpx solid #e1daea; }.player-row .row { gap: 18rpx; }.mini-seat { width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; background: #e1daea; border-radius: 50%; color: #7359ca; font-size: 22rpx; }.struck { text-decoration: line-through; color: #646873; }.day-actions { display: grid; gap: 16rpx; margin-top: 30rpx; }.finished { margin-top: 60rpx; }.role-list { width: 600rpx; margin: 40rpx auto 0; }.role-row { display: flex; justify-content: space-between; padding: 16rpx 5rpx; border-bottom: 1rpx solid #e9e4f1; font-size: 25rpx; }
.broadcast-control { margin-top: 24rpx; }
.broadcast-control .muted { font-size: 22rpx; margin-top: 12rpx; }
.broadcast-control button { margin-top: 16rpx; }
.note-btn { min-width: 82rpx; width: auto; padding: 0 12rpx; box-sizing: border-box; font-size: 23rpx; background: #ede6fb; color: #7d59cb; border-radius: 999rpx; }
.game .bottom-action { width: calc(100% - 64rpx); min-width: 0; padding: 0 16rpx; box-sizing: border-box; font-size: 26rpx; white-space: nowrap; }
.wolf-team { margin: 18rpx 0 24rpx; padding: 18rpx; border-radius: 22rpx; background: #f7f3fb; }
.wolf-team-title { color: #895eab; font-size: 22rpx; font-weight: 600; margin-bottom: 10rpx; }
.wolf-team-row { padding: 12rpx 0; border-bottom: 1rpx solid #e8dff0; }.wolf-team-row:last-child { border-bottom: 0; }
.wolf-team-name { color: #51415c; font-size: 23rpx; }.wolf-team-status { display: flex; justify-content: space-between; gap: 12rpx; color: #8c679f; font-size: 22rpx; margin-top: 7rpx; }
.wolf-team-tip { color: #9b8aa6; font-size: 21rpx; margin-top: 14rpx; line-height: 1.5; }
.wolf-suggest { width: 100%; margin-top: 22rpx; white-space: nowrap; font-size: 26rpx; }
.witch-panel { max-height: none; overflow: visible; margin-bottom: 0; }
.witch-panel .witch-actions { border-top: 0; padding-top: 0; }
.witch-section { margin-top: 22rpx; padding: 22rpx; border: 1rpx solid #e4dced; border-radius: 20rpx; background: #faf8fd; }
.witch-section-title { font-size: 27rpx; font-weight: 700; color: #51415c; margin-bottom: 16rpx; }
.witch-status { font-size: 28rpx; font-weight: 600; color: #7359ca; line-height: 1.6; }
.witch-hint { font-size: 23rpx; color: #777b87; line-height: 1.65; margin-top: 8rpx; }
.witch-medicine { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 16rpx 0; }
.witch-medicine > view { flex: 1; min-width: 0; }.witch-medicine switch { flex-shrink: 0; }
.witch-medicine-name { font-size: 27rpx; font-weight: 600; }.witch-target-label { font-size: 25rpx; font-weight: 600; margin-top: 18rpx; }
.witch-section .targets { margin-top: 16rpx; }.witch-summary { font-size: 24rpx; color: #7359ca; background: #eee6fb; padding: 20rpx; border-radius: 16rpx; margin-top: 22rpx; line-height: 1.7; }
.vote-result + .vote-result { border-top: 1rpx solid #e4dced; margin-top: 22rpx; padding-top: 22rpx; }
.vote-result-title { font-size: 26rpx; font-weight: 600; margin-bottom: 14rpx; }
.vote-total { padding: 12rpx 0; }.vote-total .between { font-size: 26rpx; font-weight: 600; }
.vote-voters { font-size: 22rpx; color: #8e839d; line-height: 1.6; margin-top: 6rpx; overflow-wrap: break-word; }
.vote-result-summary { color: #7359ca; font-size: 25rpx; font-weight: 600; margin-top: 16rpx; }

.game-tools { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; margin: 20rpx 0; width: 100%; min-width: 0; box-sizing: border-box; }
.game-tools button { display: flex; align-items: center; justify-content: center; width: 100%; max-width: 100%; min-width: 0; padding: 0 16rpx; box-sizing: border-box; margin: 0; font-size: 24rpx; min-height: 76rpx; height: 76rpx; line-height: 1.3; white-space: nowrap; }
.game-sheet-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: flex-end; }
.game-sheet-backdrop { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(32, 24, 45, .5); }
.game-sheet { position: relative; z-index: 1; width: 100%; box-sizing: border-box; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fff; }
.game-sheet .section-title { margin: 0; }
.sheet-header { display: flex; align-items: center; gap: 20rpx; width: 100%; min-width: 0; box-sizing: border-box; text-align: left; }
.sheet-header .section-title { flex: 1; min-width: 0; }
.sheet-close { flex: 0 0 112rpx; width: 112rpx; margin: 0 0 0 auto; padding: 0 24rpx; box-sizing: border-box; min-height: 64rpx; font-size: 24rpx; line-height: 64rpx; border-radius: 999rpx; color: #7359ca; background: #f2edf9; }
.identity-sheet { text-align: center; }
.identity-name { margin: 48rpx 0 24rpx; font-size: 52rpx; font-weight: 700; color: #7359ca; }
.identity-description { margin-bottom: 24rpx; font-size: 28rpx; line-height: 1.7; color: #62576f; }
.vote-sheet { padding-right: 24rpx; padding-left: 24rpx; }
.vote-sheet .sheet-header { padding: 0 8rpx 20rpx; border-bottom: 1rpx solid #eee8f3; }
.vote-history-scroll { height: 60vh; width: 100%; margin-top: 18rpx; box-sizing: border-box; }
.vote-history-content { width: 100%; padding: 4rpx 24rpx 20rpx 8rpx; box-sizing: border-box; }
.history-round { padding: 22rpx; margin-bottom: 18rpx; background: #f8f6fc; border: 1rpx solid #e9e3f1; border-radius: 20rpx; }
.history-round:last-child { margin-bottom: 0; }
.history-round-header { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx 14rpx; }
.history-day { font-size: 25rpx; color: #45384f; font-weight: 600; }
.history-kind { font-size: 22rpx; color: #93859e; }
.history-conclusion { margin: 14rpx 0 4rpx; color: #7359ca; font-size: 25rpx; font-weight: 600; line-height: 1.6; overflow-wrap: break-word; }
.history-target { padding: 18rpx 0; border-bottom: 1rpx solid #e9e3f1; }
.history-target:last-child { border-bottom: 0; padding-bottom: 0; }
.history-target-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 25rpx; color: #62576f; font-weight: 600; }
.history-vote-count { flex-shrink: 0; color: #7359ca; }
.history-voter-row { display: flex; align-items: flex-start; gap: 14rpx; margin-top: 12rpx; }
.history-label { flex: 0 0 48rpx; color: #9a8fa4; font-size: 22rpx; line-height: 40rpx; }
.history-seats { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; gap: 8rpx; }
.history-seat { display: inline-flex; align-items: center; justify-content: center; min-width: 40rpx; min-height: 40rpx; padding: 0 8rpx; box-sizing: border-box; background: #fff; border-radius: 8rpx; color: #756381; font-size: 22rpx; }
.history-sheriff { margin-top: 10rpx; color: #9a8fa4; font-size: 21rpx; line-height: 1.6; }
.history-abstained { padding-top: 4rpx; }
.history-abstained .history-seat { background: #eee9f3; color: #9a8fa4; }
.history-empty { text-align: center; padding: 60rpx 0; color: #8e839d; }

.game.safe-bottom { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }

.rules-sheet { padding-left: 24rpx; padding-right: 24rpx; }
.rules-sheet .sheet-header { padding: 0 8rpx 20rpx; border-bottom: 1rpx solid #eee8f3; }
.rules-scroll { width: 100%; height: 60vh; margin-top: 18rpx; }
.rules-content { width: 100%; padding: 4rpx 24rpx 20rpx 8rpx; box-sizing: border-box; }
.rules-card { padding: 22rpx; margin-bottom: 18rpx; border-radius: 20rpx; background: #f8f6fc; border: 1rpx solid #e9e3f1; }
.rules-section-title { color: #45384f; font-size: 27rpx; font-weight: 600; margin-bottom: 14rpx; }
.rules-setting { display: flex; justify-content: space-between; gap: 20rpx; font-size: 24rpx; line-height: 1.6; padding: 6rpx 0; }
.rules-setting-label { flex-shrink: 0; color: #93859e; }
.rules-setting > text:last-child { text-align: right; overflow-wrap: break-word; }
.rules-description { color: #81718f; font-size: 23rpx; line-height: 1.8; overflow-wrap: break-word; }
.rules-win { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #e9e3f1; }
.rules-role + .rules-role { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #e9e3f1; }
.rules-role-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 8rpx; color: #7359ca; font-size: 25rpx; font-weight: 600; }
.rules-role-count { flex-shrink: 0; color: #93859e; font-size: 22rpx; font-weight: 400; }
.rules-common + .rules-common { margin-top: 16rpx; }

.current-vote { border: 2rpx solid #d9cff1; }
.stage-history { background: #f0edf5; border-top: 2rpx solid #ded7e9; }
.stage-history .section-title { margin: 0; font-size: 25rpx; color: #8b8099; }
.history-toggle { font-size: 23rpx; color: #7359ca; }
.stage-history .vote-result { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #ddd5e8; }
.day-banner { margin: 20rpx 0; }
