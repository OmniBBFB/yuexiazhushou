<test-user-switch/>
<view wx:if="{{room && room.game}}" class="game page safe-bottom {{phase === 'NIGHT' ? 'night' : 'day'}}"><view class="between game-head"><view><text class="eyebrow">{{phaseLabel}}</text><view class="day-count">第 {{room.game.day}} 天</view></view><view class="row"><view class="pill">房间 {{room.code}}</view><view wx:if="{{isOwner || room.broadcast.userId === myId}}" class="note-btn" bindtap="openBroadcast">播报</view><view class="note-btn" bindtap="openNotes">笔记</view></view></view>
  <view class="game-tools"><button class="secondary" bindtap="openIdentity">查看身份</button><button class="secondary" bindtap="openVotes">查看投票</button><button class="secondary" bindtap="openRules">查看规则</button></view>
  <block wx:if="{{phase === 'NIGHT'}}"><view wx:if="{{!action}}" class="center waiting-night"><view class="pass-icon">◐</view><view class="focus-title">夜幕降临</view><view class="focus-sub">{{announcementText}}</view></view><block wx:else><view class="broadcast card"><view class="sound">◖))</view><view><view class="broadcast-text">{{announcementText}}</view><view class="muted">行动内容仅你本人可见</view></view></view><view class="action-panel card {{action.type === 'WITCH' ? 'witch-panel' : ''}}"><view class="section-title">{{action.type === 'GRAVEKEEPER' ? '守墓信息' : action.type === 'WILD_CHILD' ? '选择榜样' : (action.type === 'WEREWOLF' ? '选择袭击目标' : (action.type === 'SEER' ? '选择查验目标' : (action.type === 'WITCH' ? '决定是否使用药剂' : '选择守护目标')))}}</view><view wx:if="{{action.type === 'WEREWOLF'}}" class="wolf-team"><view class="wolf-team-title">狼队协作 · 仅存活狼队成员可见</view><view wx:for="{{action.wolfTeam}}" wx:key="seat" class="wolf-team-row"><view class="wolf-team-name">{{item.seat}} 号 · {{item.nickname}}{{!item.alive ? '（已出局）' : ''}}</view><view wx:if="{{item.alive}}" class="wolf-team-status"><text>建议：{{item.suggestedSeat ? item.suggestedSeat + ' 号' : '暂无'}}</text><text>选择：{{item.selectedSeat ? item.selectedSeat + ' 号' : '未确认'}}</text></view></view><view class="wolf-team-tip">建议不算投票；正式选择不一致时，可修改选择。</view></view><view wx:if="{{action.result}}" class="check-result">查验结果：<text>{{action.result}}</text></view><view wx:elif="{{action.submitted && action.type !== 'WEREWOLF'}}" class="focus-sub">行动已提交，等待同伴完成选择</view><view wx:elif="{{action.type === 'WITCH'}}" class="witch-actions">
  <view class="witch-section">
    <view class="witch-section-title">1 · 今晚遇袭情况</view>
    <view class="witch-status">{{action.attackedSeat ? action.attackedSeat + ' 号' + (action.attackedSeat === mySeat ? '（我）' : '') + '被狼人袭击' : '今晚没有玩家被狼人袭击'}}</view>
    <view class="witch-hint">遇袭不等于已经死亡。最终死亡结果将在白天公布。</view>
  </view>
  <view class="witch-section">
    <view class="witch-section-title">2 · 选择药剂</view>
    <view class="witch-medicine"><view><view class="witch-medicine-name">解药 · {{action.canSave ? '剩余 1 瓶' : '已用完'}}</view><view class="witch-hint">{{!action.canSave ? '本局不能再使用解药' : (!action.attackedSeat ? '今晚无人遇袭，不能使用解药' : (useSave ? '已选择：使用解药' : '当前：不使用解药'))}}</view></view><switch disabled="{{!actionReady || !action.canSave || !action.attackedSeat}}" color="#7963dc" checked="{{useSave}}" bindchange="toggleSave"/></view>
    <view class="witch-medicine"><view><view class="witch-medicine-name">毒药 · {{action.canPoison ? '剩余 1 瓶' : '已用完'}}</view><view class="witch-hint">{{!action.canPoison ? '本局不能再使用毒药' : (usePoison ? '已选择：使用毒药，请在下方选择目标' : '当前：不使用毒药')}}</view></view><switch disabled="{{!actionReady || !action.canPoison}}" color="#c96f6f" checked="{{usePoison}}" bindchange="togglePoison"/></view>
    <view class="witch-hint">每晚最多使用一种药剂；选择另一种会取消当前选择，也可以两种都不用。</view>
  </view>
  <view class="witch-section">
    <view class="witch-section-title">3 · 选择目标</view>
    <view class="witch-target-label">解药目标</view>
    <view class="witch-hint">{{useSave ? '固定救治 ' + action.attackedSeat + ' 号，无需另选目标' : '未使用解药，不救治任何玩家'}}</view>
    <view class="witch-target-label">毒药目标</view>
    <block wx:if="{{usePoison && action.canPoison}}"><view class="witch-hint">{{poisonSeat ? '已选择毒杀 ' + poisonSeat + ' 号（再次点击可取消）' : '请选择一名存活玩家作为毒药目标'}}</view><view class="targets"><view wx:for="{{action.targets}}" wx:key="seat" class="target {{poisonSeat === item.seat ? 'selected' : ''}}" data-seat="{{item.seat}}" bindtap="selectPoison"><text>{{item.seat}}</text><text class="target-name">{{item.seat === mySeat ? '我' : item.nickname}}</text></view></view></block>
    <view wx:else class="witch-hint">未使用毒药，无需选择目标</view>
  </view>
  <view class="witch-summary">本次行动：{{useSave ? '解药救 ' + action.attackedSeat + ' 号' : '不用解药'}}；{{usePoison ? (poisonSeat ? '毒药毒 ' + poisonSeat + ' 号' : '毒药尚未选择目标') : '不用毒药'}}。点击下方按钮后提交。</view>
</view><view wx:else class="targets"><view wx:for="{{action.targets}}" wx:key="seat" class="target {{selectedSeat === item.seat ? 'selected' : ''}}" data-seat="{{item.seat}}" bindtap="selectTarget"><text>{{item.seat}}</text><text class="target-name">{{item.seat === mySeat ? '我' : item.nickname}}</text></view></view></view><button wx:if="{{action.type === 'WEREWOLF'}}" class="secondary wolf-suggest" disabled="{{!actionReady || !selectedSeat}}" bindtap="suggestWolfTarget">建议此目标</button><button wx:if="{{!action.submitted || action.result || action.type === 'WEREWOLF'}}" class="primary bottom-action" disabled="{{!actionReady}}" bindtap="submitAction">{{!actionReady ? '正在播报，请稍候' : (action.type === 'WEREWOLF' ? (action.submitted ? '修改袭击目标' : '确认袭击目标') : (action.type === 'WILD_CHILD' ? '确认榜样' : (action.result ? '记住结果并确认' : '确认行动')))}}</button></block></block>
  <block wx:elif="{{phase === 'DAWN'}}"><view class="center dawn"><view class="sun">☼</view><view class="focus-title">{{room.game.resultPending ? '首夜结束' : '天亮了'}}</view><view class="focus-sub">{{dawnText}}</view><view class="pill">{{room.game.confirmedCount}} / {{room.game.totalCount}} 存活玩家已确认</view></view><button class="primary bottom-action" disabled="{{dawnConfirmed}}" bindtap="confirmDawn">{{!confirmationRequired ? '无需确认 · 等待存活玩家' : dawnConfirmed ? '已确认 · 等待玩家' : (room.game.resultPending ? '确认进入警长竞选' : '我已查看结果')}}</button></block>
  <block wx:elif="{{phase === 'DAY'}}"><view wx:for="{{room.members}}" wx:key="userId" wx:if="{{item.revealedRole}}" class="pill">{{item.seat}} 号已公开身份：{{item.revealedRole}}</view><view class="day-banner"><view class="sun small">☼</view><view><view class="focus-title">{{phaseLabel}}</view><view class="focus-sub">警长 {{room.game.dayView && room.game.dayView.sheriffSeat ? room.game.dayView.sheriffSeat + ' 号' : '暂缺'}}</view></view></view>
    <view wx:if="{{!room.game.dayView}}" class="card day-flow"><view class="section-title">正在同步白天阶段</view><view class="focus-sub">请稍候，系统正在恢复当前流程。</view></view>
    <view wx:if="{{room.game.dayView.stage === 'SHERIFF_SIGNUP'}}" class="card day-flow"><view class="section-title">竞选警长</view><view wx:if="{{!room.game.dayView.submitted}}" class="dual-actions"><button class="primary" data-join="{{true}}" bindtap="sheriffSignup">上警</button><button class="secondary" data-join="{{false}}" bindtap="sheriffSignup">不上警</button></view><view wx:else class="submitted-tip">已选择，等待其他玩家</view></view>
    <view wx:elif="{{(room.game.dayView.stage === 'SHERIFF_VOTE' && !room.game.dayView.canSheriffVote) || (room.game.dayView.stage === 'EXILE_VOTE' && !room.game.dayView.canExileVote)}}" class="card day-flow"><view class="submitted-tip">无法投票</view></view>
    <view wx:elif="{{room.game.dayView.stage === 'SHERIFF_VOTE'}}" class="card day-flow"><view class="section-title">{{room.game.dayView.voteRound === 2 ? '警长 PK 投票' : '选举警长'}}</view><view wx:if="{{room.game.dayView.voteRound === 2}}" class="focus-sub">第二轮 · 全员可投票</view><view wx:if="{{!room.game.dayView.submitted}}" class="targets"><view wx:for="{{room.game.dayView.targets}}" wx:key="seat" class="target {{selectedDaySeat === item.seat ? 'selected' : ''}}" data-seat="{{item.seat}}" bindtap="selectDayTarget"><text>{{item.seat}}</text><text class="target-name">{{item.seat === mySeat ? '我' : item.nickname}}</text></view></view><button wx:if="{{!room.game.dayView.submitted}}" class="primary flow-button" disabled="{{!selectedDaySeat}}" bindtap="sheriffVote">确认投票</button><view wx:else class="submitted-tip">已投票，等待结果</view></view>
    <view wx:elif="{{room.game.dayView.stage === 'NIGHT_RESULT'}}" class="card day-flow"><view class="section-title">首夜结果</view><view class="result-banner">{{room.game.dayView.resultText}}</view><button wx:if="{{!room.game.dayView.submitted && !room.game.dayView.nextAfterResult}}" class="primary flow-button" bindtap="confirmFirstNightResult">我已查看结果</button><view wx:else class="submitted-tip">{{room.game.dayView.nextAfterResult ? '正在公布首夜情况，稍后自动进入下一阶段' : (confirmationRequired ? '已确认，等待存活玩家' : '无需确认，等待存活玩家')}}</view></view>
    <view wx:elif="{{room.game.dayView.stage === 'SPEECH_ORDER'}}" class="card day-flow"><view class="section-title">决定发言顺序</view><view wx:if="{{room.game.dayView.resultText}}" class="result-banner">{{room.game.dayView.resultText}}</view><block wx:if="{{room.game.dayView.canChooseOrder}}"><view class="dual-actions compact"><button class="{{speechDirection === 'ASC' ? 'primary' : 'secondary'}}" data-direction="ASC" bindtap="setDirection">顺时针</button><button class="{{speechDirection === 'DESC' ? 'primary' : 'secondary'}}" data-direction="DESC" bindtap="setDirection">逆时针</button></view><button class="primary flow-button" bindtap="setSpeechOrder">确认顺序</button></block><view wx:else class="submitted-tip">等待选择发言顺序</view></view>
    <view wx:elif="{{room.game.dayView.stage === 'SPEECH' || room.game.dayView.stage === 'SHERIFF_SPEECH' || room.game.dayView.stage === 'SHERIFF_PK_SPEECH' || room.game.dayView.stage === 'EXILE_PK_SPEECH'}}" class="card day-flow speech-card"><view class="section-title">{{room.game.dayView.speakerSeat}} 号玩家{{room.game.dayView.stage === 'SHERIFF_PK_SPEECH' || room.game.dayView.stage === 'EXILE_PK_SPEECH' ? 'PK 发言' : (room.game.dayView.stage === 'SHERIFF_SPEECH' ? '竞选发言' : '发言')}}</view><view class="timer">{{countdown}}</view><view class="focus-sub">剩余秒数</view><button wx:if="{{room.game.dayView.canFinishSpeech}}" class="secondary flow-button" disabled="{{!room.game.dayView.speechExtensionsRemaining}}" bindtap="extendSpeech">+30 秒 · 剩余 {{room.game.dayView.speechExtensionsRemaining}} 次</button><button wx:if="{{room.game.dayView.canFinishSpeech}}" class="primary flow-button" bindtap="finishSpeech">结束发言</button><button wx:if="{{room.game.dayView.canWithdraw}}" class="secondary flow-button" bindtap="withdrawSheriff">退水</button><view wx:if="{{room.game.dayView.withdrawnSeats.length}}" class="focus-sub">已退水：{{room.game.dayView.withdrawnSeats}} 号</view></view>
    <view wx:elif="{{room.game.dayView.stage === 'EXILE_VOTE'}}" class="card day-flow"><view class="section-title">{{room.game.dayView.voteRound === 2 ? '放逐 PK 投票' : '放逐投票'}}</view><view class="focus-sub">{{room.game.dayView.voteRound === 2 ? '第二轮 · 选择 PK 玩家' : '选择目标，或弃票'}}</view><view wx:if="{{room.game.dayView.myVoteWeight === 1.5}}" class="pill">警长 · 1.5 票</view><view class="targets"><view wx:for="{{room.game.dayView.targets}}" wx:key="seat" class="target {{selectedDaySeat === item.seat ? 'selected' : ''}}" data-seat="{{item.seat}}" bindtap="selectDayTarget"><text>{{item.seat}}</text><text class="target-name">{{item.seat === mySeat ? '我' : item.nickname}}</text></view></view><button wx:if="{{room.game.dayView.canExileVote && !room.game.dayView.submitted}}" class="primary flow-button" bindtap="exileVote">{{selectedDaySeat ? '提交放逐票' : '弃票'}}</button><view wx:else class="submitted-tip">{{room.game.dayView.canExileVote ? '投票已提交，等待其他玩家' : '你没有放逐投票资格，等待其他玩家'}}</view></view>
    <view wx:elif="{{room.game.dayView.stage === 'DEATH_SKILL'}}" class="card day-flow"><view class="section-title">{{room.game.dayView.shooterSeat}} 号正在处理死亡技能</view><view class="focus-sub">剩余 {{countdown}} 秒，超时自动放弃；技能处理后再判定胜负。</view><block wx:if="{{action && action.type === 'SHOOT'}}"><view class="targets"><view wx:for="{{action.targets}}" wx:key="seat" class="target {{selectedDaySeat === item.seat ? 'selected' : ''}}" data-seat="{{item.seat}}" bindtap="selectDayTarget"><text>{{item.seat}}</text><text class="target-name">{{item.nickname}}</text></view></view><button class="primary flow-button" bindtap="shoot">确认开枪</button><button class="secondary flow-button" data-skip="true" bindtap="shoot">放弃开枪</button></block><view wx:else class="submitted-tip">等待该玩家开枪或放弃</view></view>
    <view wx:elif="{{room.game.dayView.stage === 'COMPLETE'}}" class="card day-flow"><view class="section-title">白天结束</view><view class="result-banner">{{room.game.dayView.resultText}}</view><view class="focus-sub">全体存活玩家确认后，自动进入下一夜或公布胜负。</view><button wx:if="{{confirmationRequired && !room.game.dayView.submitted}}" class="primary flow-button" bindtap="nextNight">确认进入下一夜</button><view wx:else class="submitted-tip">{{confirmationRequired ? '已确认，等待其他存活玩家' : '无需确认，等待存活玩家'}}</view></view>
    <view wx:if="{{room.game.dayView.canDuel || (room.game.dayView.canExplode && room.game.myRole.role === '白狼王')}}" class="card day-flow"><view class="section-title">{{room.game.dayView.canDuel ? '骑士决斗' : '白狼王自爆带人'}}</view><view class="focus-sub">请选择其他存活玩家；技能确认后立即生效。</view><view class="targets"><view wx:for="{{room.game.dayView.targets}}" wx:key="seat" wx:if="{{item.seat !== mySeat}}" class="target {{selectedDaySeat === item.seat ? 'selected' : ''}}" data-seat="{{item.seat}}" bindtap="selectDayTarget"><text>{{item.seat}}</text><text class="target-name">{{item.nickname}}</text></view></view><button wx:if="{{room.game.dayView.canDuel}}" class="primary flow-button" bindtap="knightDuel">确认决斗</button></view>
    <button wx:if="{{room.game.dayView.canExplode}}" class="secondary danger explode-button" bindtap="wolfExplode">{{room.game.myRole.role === '白狼王' ? '白狼王自爆带人' : '狼人自爆'}}</button><button wx:if="{{isOwner}}" class="leave" bindtap="finishGame">异常结束本局</button>
    <view wx:if="{{currentVote}}" class="card day-flow current-vote">
      <view class="section-title">本阶段最新结果 · 第 {{currentVote.round}} 轮</view>
      <view class="vote-result-summary">{{currentVote.summary}}</view>
      <view wx:for="{{currentVote.totals}}" wx:key="seat" class="vote-total"><view class="between"><text>{{item.seat}} 号</text><text>{{item.votes}} 票</text></view><view class="vote-voters">投票：{{item.voterSeats}} 号<text wx:if="{{item.sheriffVoterSeats.length}}"> · {{item.sheriffVoterSeats}} 号计 1.5 票</text></view></view>
      <view wx:if="{{currentVote.abstainedSeats.length}}" class="vote-voters">弃票：{{currentVote.abstainedSeats}} 号</view>
    </view>
    <view wx:if="{{previousVotes.length}}" class="card stage-history">
      <view class="between" bindtap="toggleStageHistory"><view class="section-title">之前阶段与轮次 · {{previousVotes.length}} 条</view><text class="history-toggle">{{stageHistoryOpen ? '收起' : '展开'}}</text></view>
      <block wx:if="{{stageHistoryOpen}}"><view wx:for="{{previousVotes}}" wx:for-index="historyIndex" wx:key="historyIndex" class="vote-result"><view class="vote-result-title">第 {{item.day}} 天 · {{item.kind === 'SHERIFF' ? '警长竞选' : '放逐投票'}} · 第 {{item.round}} 轮</view><view class="vote-result-summary">{{item.summary}}</view><view wx:for="{{item.totals}}" wx:for-item="total" wx:key="seat" class="vote-voters">{{total.seat}} 号：{{total.votes}} 票 · 投票 {{total.voterSeats}} 号</view><view wx:if="{{item.abstainedSeats.length}}" class="vote-voters">弃票：{{item.abstainedSeats}} 号</view></view></block>
    </view>
  </block>
  <block wx:elif="{{phase === 'FINISHED'}}"><view class="center finished"><text class="eyebrow">GAME OVER</text><view class="focus-title">{{room.game.winner}}</view><view class="role-list"><view wx:for="{{room.members}}" wx:key="seat" class="role-row"><text>{{item.seat}}号 · {{item.nickname}}</text><text class="gold">{{item.finalRole}}{{item.finalRole === '野孩子' ? (item.finalCamp === 'WOLF' ? ' · 狼人阵营' : ' · 好人阵营') : ''}}</text></view></view></view><button wx:if="{{isOwner}}" class="primary bottom-action" bindtap="backRoom">返回房间 · 再来一局</button></block>
  <view wx:if="{{room.game.skillHistory.length}}" class="card"><view class="section-title">公开技能记录</view><view wx:for="{{room.game.skillHistory}}" wx:key="text" class="focus-sub">第 {{item.day}} 天 · {{item.text}}</view></view>
</view>

<view wx:if="{{identityOpen && room.game.myRole}}" class="game-sheet-mask"><view class="game-sheet-backdrop" catchtouchmove="keepSheet" bindtap="closeIdentity"></view><view class="game-sheet identity-sheet" catchtap="keepSheet" catchtouchmove="keepSheet"><view class="sheet-header"><view class="section-title">我的身份</view><button class="sheet-close" bindtap="closeIdentity">关闭</button></view><view class="identity-name">{{room.game.myRole.role}}{{room.game.myRole.transformed ? ' · 已转为狼人' : ''}}</view><view wx:if="{{room.game.myRole.modelSeat}}" class="muted">榜样：{{room.game.myRole.modelSeat}} 号</view><view wx:if="{{room.game.myRole.graveResult}}" class="check-result">守墓信息 · 第 {{room.game.myRole.graveResult.day}} 天：{{room.game.myRole.graveResult.seat ? room.game.myRole.graveResult.seat + ' 号被放逐，属于' + room.game.myRole.graveResult.camp : '没有玩家被放逐'}}</view><view class="identity-description">{{room.game.myRole.description}}</view><view class="muted">仅你本人可见</view></view></view>
<view wx:if="{{voteSheetOpen}}" class="game-sheet-mask">
  <view class="game-sheet-backdrop" catchtouchmove="keepSheet" bindtap="closeVotes"></view>
  <view class="game-sheet vote-sheet" catchtap="keepSheet">
    <view class="sheet-header" catchtouchmove="keepSheet"><view class="section-title">本局投票记录</view><button class="sheet-close" bindtap="closeVotes">关闭</button></view>
    <scroll-view scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="vote-history-scroll">
      <view class="vote-history-content">
        <view wx:if="{{!room.game.voteHistory || !room.game.voteHistory.length}}" class="history-empty">暂无已结算的投票</view>
        <view wx:for="{{voteHistoryNewest}}" wx:for-item="result" wx:for-index="resultIndex" wx:key="resultIndex" class="history-round">
          <view class="history-round-header"><text class="history-day">第 {{result.day}} 天</text><text class="history-kind">{{result.kind === 'SHERIFF' ? '警长竞选' : '放逐投票'}} · 第 {{result.round}} 轮</text></view>
          <view class="history-conclusion">{{result.summary}}</view>
          <view wx:for="{{result.totals}}" wx:for-item="total" wx:key="seat" class="history-target">
            <view class="history-target-heading"><text>{{total.seat}} 号</text><text class="history-vote-count">{{total.votes}} 票</text></view>
            <view class="history-voter-row"><text class="history-label">投票</text><view class="history-seats"><text wx:for="{{total.voterSeats}}" wx:for-item="seat" wx:key="*this" class="history-seat">{{seat}}</text></view></view>
            <view wx:if="{{total.sheriffVoterSeats.length}}" class="history-sheriff">{{total.sheriffVoterSeats}} 号为警长，计 1.5 票</view>
          </view>
          <view wx:if="{{result.abstainedSeats.length}}" class="history-voter-row history-abstained"><text class="history-label">弃票</text><view class="history-seats"><text wx:for="{{result.abstainedSeats}}" wx:for-item="seat" wx:key="*this" class="history-seat">{{seat}}</text></view></view>
        </view>
        <view wx:if="{{room.game.sheriffElection}}" class="history-round">
          <view class="history-round-header"><text class="history-day">第 {{room.game.sheriffElection.day}} 天</text><text class="history-kind">上警与退水</text></view>
          <view class="history-voter-row"><text class="history-label">上警</text><view class="history-seats"><text wx:for="{{room.game.sheriffElection.signedSeats}}" wx:key="*this" class="history-seat">{{item}}</text><text wx:if="{{!room.game.sheriffElection.signedSeats.length}}">无人上警</text></view></view>
          <view class="history-voter-row"><text class="history-label">退水</text><view class="history-seats"><text wx:for="{{room.game.sheriffElection.withdrawnSeats}}" wx:key="*this" class="history-seat">{{item}}</text><text wx:if="{{!room.game.sheriffElection.withdrawnSeats.length}}">暂无</text></view></view>
          <view class="history-voter-row"><text class="history-label">参选</text><view class="history-seats"><text wx:for="{{room.game.sheriffElection.candidateSeats}}" wx:key="*this" class="history-seat">{{item}}</text><text wx:if="{{!room.game.sheriffElection.candidateSeats.length}}">暂无</text></view></view>
          <view class="history-conclusion">{{room.game.sheriffElection.interrupted ? '自爆中断警长竞选' : room.game.sheriffElection.completed ? (room.game.sheriffElection.sheriffSeat ? room.game.sheriffElection.sheriffSeat + ' 号当选警长' : '未产生警长') : '竞选进行中'}}</view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<view wx:if="{{rulesOpen && roomRules}}" class="game-sheet-mask">
  <view class="game-sheet-backdrop" catchtouchmove="keepSheet" bindtap="closeRules"></view>
  <view class="game-sheet rules-sheet" catchtap="keepSheet">
    <view class="sheet-header" catchtouchmove="keepSheet"><view class="section-title">本场规则</view><button class="sheet-close" bindtap="closeRules">关闭</button></view>
    <scroll-view scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="rules-scroll">
      <view class="rules-content">
        <view class="rules-card"><view class="rules-section-title">房间设置</view><view wx:for="{{roomRules.settings}}" wx:key="label" class="rules-setting"><text class="rules-setting-label">{{item.label}}</text><text>{{item.value}}</text></view><view class="rules-description rules-win">{{roomRules.winRule}}</view></view>
        <view wx:for="{{roomRules.groups}}" wx:for-item="group" wx:key="title" class="rules-card"><view class="rules-section-title">{{group.title}}</view><view wx:for="{{group.roles}}" wx:for-item="role" wx:key="role" class="rules-role"><view class="rules-role-heading"><text>{{role.role}}</text><text class="rules-role-count">{{role.count}} 人</text></view><view class="rules-description">{{role.description}}</view></view></view>
        <view class="rules-card"><view class="rules-section-title">流程说明</view><view wx:for="{{roomRules.common}}" wx:key="*this" class="rules-description rules-common">{{item}}</view></view>
      </view>
    </scroll-view>
  </view>
</view>
