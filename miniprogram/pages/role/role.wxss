.role-page { text-align: center; background: radial-gradient(circle at 50% 28%, #e8e2fb 0, #f4f3fa 45%); }.role-page>.eyebrow { display: block; margin-top: 30rpx; }.center,.waiting { margin-top: 180rpx; }.pass-icon { margin: auto; width: 170rpx; height: 170rpx; line-height: 170rpx; border-radius: 50%; border: 1rpx solid #c8b9ee; color: #7359ca; background: #ede7fb; font-size: 72rpx; }.focus-title { font-size: 50rpx; font-weight: 800; margin-top: 40rpx; }.focus-sub { color: #9295a0; line-height: 1.7; max-width: 560rpx; margin: 20rpx auto; font-size: 26rpx; }.waiting .pill { margin-top: 25rpx; }.bottom-action { position: fixed; left: 32rpx; right: 32rpx; bottom: calc(40rpx + env(safe-area-inset-bottom)); }
