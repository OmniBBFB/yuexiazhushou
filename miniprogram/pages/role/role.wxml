<test-user-switch/>
<view wx:if="{{room}}" class="page role-page safe-bottom"><text class="eyebrow">YOUR ROLE</text><view wx:if="{{confirmed}}" class="waiting"><view class="pass-icon">✓</view><view class="focus-title">身份已确认</view><view class="focus-sub">等待其他玩家在各自手机完成确认</view><view class="pill">{{confirmedCount}} / {{totalCount}}</view></view><block wx:else><view class="center"><view class="pass-icon">{{revealed ? roleIcon : '◌'}}</view><view class="focus-title">{{revealed ? role : '查看我的身份'}}</view><view class="focus-sub">{{revealed ? description : '确认周围无人查看后再揭示'}}</view></view><button wx:if="{{!revealed}}" class="primary bottom-action" bindtap="reveal">查看身份</button><button wx:else class="primary bottom-action" bindtap="confirm">我已记住</button></block></view>
