.lobby { padding-top: 50rpx; }.room-code { font-size: 62rpx; font-weight: 800; letter-spacing: 8rpx; margin-top: 8rpx; }.progress { height: 8rpx; background: #f0eaf8; border-radius: 9rpx; overflow: hidden; margin-top: 42rpx; }.progress-bar { height: 100%; background: #7359ca; }.count { margin: 14rpx 0 30rpx; color: #797d89; font-size: 23rpx; }.seats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18rpx; }.seat { position: relative; background: #ffffff; border: 1rpx dashed #ddd6e9; border-radius: 22rpx; min-height: 184rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }.seat.occupied { border-style: solid; background: #fcfbff; }.seat.mine { border-color: #7359ca; box-shadow: inset 0 0 0 2rpx rgba(109,91,215,.12); }.seat-number { position: absolute; left: 12rpx; top: 8rpx; color: #646873; font-size: 20rpx; }.seat-avatar { width: 58rpx; height: 58rpx; line-height: 58rpx; text-align: center; background: #eee7fb; color: #7359ca; border-radius: 50%; font-weight: 700; }.seat-name { font-size: 23rpx; margin-top: 10rpx; }.status { font-size: 18rpx; color: #777b87; margin-top: 4rpx; }.status.ready { color: #70a687; }.rules { margin: 30rpx 0; font-size: 23rpx; }.rules .between { margin-top: 18rpx; }.ready-button { margin-bottom: 18rpx; }.primary[disabled],.secondary[disabled] { background: #e6e1ef; color: #a59ab5; }.waiting-owner { text-align: center; color: #858995; padding: 25rpx; }.leave { background: transparent; color: #6e7079; font-size: 23rpx; margin-top: 20rpx; }
