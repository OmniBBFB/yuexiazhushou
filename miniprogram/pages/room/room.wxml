<test-user-switch/>
<view wx:if="{{room}}" class="page lobby safe-bottom">
  <view class="between"><view><text class="eyebrow">ROOM</text><view class="room-code">{{room.code}}</view></view><view class="pill">{{room.config.total}} 人 · {{room.config.winMode}}</view></view><view class="subtitle">每位玩家请使用自己的手机加入并选择座位</view>
  <view class="progress"><view class="progress-bar" style="width: {{progress}}%"></view></view><view class="between count"><text>已加入 {{room.members.length}} / {{room.config.total}}</text><text>已准备 {{readyCount}}</text></view>
  <view class="seats"><view wx:for="{{seats}}" wx:key="seat" class="seat {{item.member ? 'occupied' : ''}} {{mySeat === item.seat ? 'mine' : ''}}" data-seat="{{item.seat}}" bindtap="pickSeat"><view class="seat-number">{{item.seat}}</view><view class="seat-avatar">{{item.avatar}}</view><view class="seat-name">{{pendingSeat === item.seat ? '正在入座…' : (item.member ? item.member.nickname : '选择座位')}}</view><view wx:if="{{item.member}}" class="status {{item.member.ready ? 'ready' : ''}}">{{item.member.isBot ? '服务器机器人' : (item.member.ready ? '已准备' : (item.member.userId === myId ? '这是你' : '未准备'))}}</view></view></view>
<button wx:if="{{isOwner || room.broadcast.userId === myId}}" class="ghost flow-button" bindtap="openBroadcast">播报设置</button>
  <button wx:if="{{isOwner && room.status === 'WAITING'}}" class="secondary flow-button" disabled="{{rotatingSeats || starting}}" bindtap="rotateSeats">{{rotatingSeats ? '正在轮换…' : '座位顺移一位'}}</button>
  <button wx:if="{{isOwner && isVirtualTest && room.status === 'WAITING'}}" class="ghost flow-button" disabled="{{preparingVirtualPlayers || starting || rotatingSeats}}" bindtap="readyVirtualPlayers">{{preparingVirtualPlayers ? '正在准备…' : '一键准备虚拟玩家'}}</button>
  <view class="card rules"><view class="section-title">本局规则</view><view class="between"><text class="muted">阵容</text><text>{{room.config.wolves}} 狼 · {{room.config.gods}} 神 · {{room.config.villagers}} 民</text></view><view class="between"><text class="muted">胜利方式</text><text>{{room.config.winMode}}</text></view></view>
  <view wx:if="{{room.config.wolfRoles.length}}" class="muted">特殊狼人：{{room.config.wolfRoles}}（占用狼人名额）</view>
  <view wx:if="{{room.config.godRoles}}" class="muted"><text>神职配置：</text><text wx:for="{{room.config.godRoles}}" wx:key="*this">{{index ? "、" : ""}}{{item}}</text></view>
  <view wx:if="{{room.config.wildChild}}" class="muted">特殊角色：野孩子（替换一名村民）</view>
  <button wx:if="{{isOwner && !full}}" class="ghost bot-button" bindtap="addBots">测试：用机器人补齐空位</button><button class="secondary ready-button" disabled="{{!mySeat || pendingSeat}}" bindtap="toggleReady">{{myReady ? '取消准备' : (mySeat ? '我已准备' : '请先选择座位')}}</button><button wx:if="{{isOwner}}" class="primary" disabled="{{!canStart || starting}}" bindtap="start">{{starting ? '正在分配身份…' : (canStart ? '开始游戏' : '等待全员入座并准备')}}</button><view wx:else class="waiting-owner">等待房主开始游戏</view><button class="leave" bindtap="leave">{{isOwner ? '解散房间' : '离开房间'}}</button>
</view>
