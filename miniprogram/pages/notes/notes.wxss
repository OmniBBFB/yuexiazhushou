page { height: 100%; overflow: hidden; }
.notebook { height: 100vh; display: flex; flex-direction: column; background: #f4f3f9; color: #24222f; }
.notebook-toolbar { display: flex; flex-shrink: 0; align-items: center; width: 100%; box-sizing: border-box; padding: 18rpx 24rpx 12rpx; background: #fff; }
.toolbar-side { flex: 0 0 112rpx; width: 112rpx; min-width: 0; display: flex; align-items: center; }
.toolbar-side-right { justify-content: flex-end; }
.notebook-back { display: flex; flex: 0 0 80rpx; align-items: center; justify-content: center; width: 80rpx; min-width: 0; max-width: 80rpx; height: 80rpx; margin: 0; padding: 0; box-sizing: border-box; line-height: 1; border-radius: 50%; background: #f4f3f9; color: #24222f; font-size: 58rpx; }
.notebook-heading { flex: 1 1 0; min-width: 0; padding: 0 12rpx; text-align: center; }
.notebook-title { font-size: 34rpx; font-weight: 700; }
.save-state { flex-shrink: 0; box-sizing: border-box; width: 100%; padding: 0 24rpx 14rpx; background: #fff; border-bottom: 1rpx solid #e4e1ec; color: #8d889e; font-size: 20rpx; line-height: 1.5; text-align: center; overflow-wrap: break-word; }
.save-notes { display: flex; flex: 0 0 112rpx; align-items: center; justify-content: center; width: 112rpx; min-width: 0; max-width: 112rpx; height: 80rpx; margin: 0; padding: 0; box-sizing: border-box; line-height: 1; white-space: nowrap; color: #6658d8; background: #fff; border: 1rpx solid #8a7ee3; border-radius: 24rpx; font-size: 26rpx; }
.private-hint { padding: 14rpx 32rpx; color: #8d889e; font-size: 19rpx; text-align: center; }
.notebook-list { flex: 1; height: 0; min-height: 0; width: 100%; }
.notebook-row { display: flex; align-items: center; gap: 12rpx; margin: 0 12rpx 10rpx; padding: 12rpx 14rpx; min-height: 76rpx; box-sizing: border-box; background: #fff; border-radius: 36rpx; box-shadow: 0 3rpx 9rpx rgba(45,35,85,.04); }
.notebook-seat { width: 32rpx; text-align: center; font-size: 26rpx; font-weight: 700; flex-shrink: 0; }
.guess-entry { min-width: 70rpx; height: 44rpx; line-height: 44rpx; padding: 0 10rpx; box-sizing: border-box; border-radius: 22rpx; font-size: 18rpx; text-align: center; flex-shrink: 0; }
.guess-entry.empty { min-width: 40rpx; width: 40rpx; height: 40rpx; line-height: 34rpx; border: 2rpx dashed #777180; padding: 0; border-radius: 50%; font-size: 28rpx; color: #777180; }
.sheriff-entry { width: 65rpx; height: 50rpx; line-height: 50rpx; text-align: center; background: #f4f3f9; color: #9993a6; border-radius: 14rpx; flex-shrink: 0; font-size: 20rpx; }
.sheriff-entry.marked { background: #ece7fb; color: #7356c8; }
.speech-entry { flex: 1; min-width: 0; width: 0; min-height: 48rpx; padding: 10rpx 16rpx; box-sizing: border-box; line-height: 1.6; background: #f7f6fa; border-radius: 20rpx; font-size: 25rpx; color: #363141; }
.note-placeholder { color: #a4a0ad; }
.notebook-empty,.notebook-list-end { text-align: center; padding: 28rpx; color: #9993a6; font-size: 21rpx; }
.notebook-records { flex-shrink: 0; padding: 18rpx 28rpx 16rpx; border-top: 1rpx solid #dedbe7; }
.record-title { font-size: 24rpx; font-weight: 600; margin-bottom: 12rpx; }
.record-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.record-fields textarea { box-sizing: border-box; width: 100%; height: 124rpx; border: 2rpx solid #d8d4e1; border-radius: 24rpx; background: #fff; padding: 16rpx; font-size: 26rpx; color: #363141; }
.notebook-legend { flex-shrink: 0; display: flex; align-items: center; justify-content: center; gap: 28rpx; padding: 18rpx 16rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e4e1ec; color: #625b70; font-size: 20rpx; }
.notebook-legend view { display: flex; align-items: center; gap: 8rpx; }
.legend-dot { width: 14rpx; height: 14rpx; border-radius: 50%; display: inline-block; }
.god { background: #eee5f8; color: #8954bf; }
.civilian { background: #e0f2e7; color: #268956; }
.wolf { background: #fae4e6; color: #bc3c4e; }
.unknown { background: #f0eef5; color: #7b748d; }
.legend-dot.god { background: #8954bf; }.legend-dot.civilian { background: #268956; }.legend-dot.wolf { background: #bc3c4e; }
.role-sheet-mask { position: fixed; inset: 0; z-index: 30; background: rgba(35,25,60,.25); display: flex; align-items: flex-end; }
.role-sheet { width: 100%; box-sizing: border-box; padding: 32rpx 30rpx calc(32rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 32rpx 32rpx 0 0; }
.role-sheet .section-title { margin: 0; }.role-sheet .muted { font-size: 23rpx; margin-top: 14rpx; }
.sheet-close { font-size: 40rpx; color: #8d889e; padding: 4rpx 12rpx; }
.role-guess-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 28rpx; }
.role-guess-chip { border-radius: 28rpx; padding: 18rpx 8rpx; text-align: center; font-size: 25rpx; }

.notebook-toolbar { padding: 8rpx 24rpx; }
.toolbar-side { flex-basis: 56rpx; width: 56rpx; }
.toolbar-side-right { flex-basis: 184rpx; width: 184rpx; gap: 8rpx; }
.notebook-back { flex-basis: 48rpx; width: 48rpx; max-width: 48rpx; height: 48rpx; font-size: 40rpx; }
.notebook-title { font-size: 28rpx; }
.save-notes,.graph-entry { flex: 0 0 72rpx; width: 72rpx; max-width: 72rpx; height: 48rpx; font-size: 22rpx; border-radius: 14rpx; }
.graph-entry { flex-basis: 104rpx; width: 104rpx; max-width: 104rpx; margin: 0; padding: 0; line-height: 48rpx; background: #f0edff; color: #6658d8; }
.save-state { padding-bottom: 8rpx; }
.notebook-list { padding-top: 10rpx; }
.remaining-guesses { margin-top: 20rpx; padding: 16rpx; border-radius: 16rpx; background: #f4f2fb; font-size: 25rpx; }
.count-hint,.count-warning { margin-top: 10rpx; font-size: 21rpx; color: #8d889e; }
.count-warning { color: #bc3c4e; }

.guess-entry { max-width: 180rpx; height: auto; min-height: 44rpx; line-height: 1.5; padding: 8rpx 10rpx; overflow-wrap: break-word; }
.guess-entry.empty { height: 40rpx; min-height: 40rpx; padding: 0; line-height: 34rpx; }
.role-guess-chip.chosen { box-shadow: inset 0 0 0 3rpx currentColor; font-weight: 600; }
.role-guess-options { gap: 12rpx; margin-top: 18rpx; }
.role-guess-chip { padding: 14rpx 8rpx; }
.guess-done { margin-top: 20rpx; height: 64rpx; line-height: 64rpx; font-size: 26rpx; background: #6658d8; color: #fff; }
.role-sheet { max-height: 90vh; overflow-y: auto; }
