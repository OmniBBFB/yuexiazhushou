page { min-height: 100%; background: #f4f3fa; color: #272332; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
button { margin: 0; border-radius: 999rpx; font-weight: 600; font-size: 29rpx; }
button::after { border: 0; }
.page { min-height: 100vh; box-sizing: border-box; padding: 30rpx 30rpx 64rpx; }
.eyebrow { color: #7863d8; font-size: 21rpx; letter-spacing: 3rpx; font-weight: 600; }
.title { font-size: 44rpx; line-height: 1.3; font-weight: 750; margin-top: 12rpx; }
.subtitle { color: #8a8198; font-size: 25rpx; line-height: 1.7; margin-top: 14rpx; }
.card { background: #fff; border: 1rpx solid #eeebf5; border-radius: 36rpx; padding: 30rpx; box-sizing: border-box; box-shadow: 0 6rpx 20rpx rgba(54,39,87,.045); }
.primary { background: linear-gradient(105deg, #8880f6, #5e4be7); color: #fff; min-height: 96rpx; line-height: 96rpx; box-shadow: 0 8rpx 24rpx rgba(102,78,211,.15); }
.secondary { background: #eee9f9; color: #6c56c7; min-height: 86rpx; line-height: 86rpx; }
button[disabled] { background: #e6e1ef; color: #a59ab5; box-shadow: none; }
.danger { background: #f9e7ec; color: #b94b66; }
.ghost { background: #fff; color: #7159cc; border: 1rpx solid #d5c9ef; }
.label { display: block; font-size: 25rpx; font-weight: 600; color: #676071; margin: 28rpx 0 14rpx; }
.input { height: 90rpx; background: #f7f5fb; border: 1rpx solid #e1dbe9; border-radius: 24rpx; padding: 0 24rpx; color: #35303f; box-sizing: border-box; }
.section-title { font-weight: 650; font-size: 29rpx; margin-bottom: 22rpx; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.muted { color: #8e839d; }
.gold { color: #7359ca; }
.pill { display: inline-flex; align-items: center; padding: 8rpx 17rpx; border-radius: 999rpx; font-size: 22rpx; background: #ede8fa; color: #7660cc; }
.safe-bottom { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.camp-wolf { background: #fbe5e8; color: #b73c4c; }
.camp-god { background: #efe6f8; color: #8a50bd; }
.camp-civilian { background: #e2f3e8; color: #2f8e58; }
.day-flow { margin-top: 24rpx; }
.dual-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 30rpx; min-width: 0; width: 100%; box-sizing: border-box; }
.dual-actions button { width: 100%; min-width: 0; max-width: 100%; margin: 0; padding: 0 12rpx; box-sizing: border-box; white-space: nowrap; }
.dual-actions.compact button { min-height: 70rpx; line-height: 70rpx; font-size: 24rpx; }
.submitted-tip { padding: 32rpx 0; text-align: center; color: #8b8099; }
.flow-button { margin-top: 28rpx; width: 100%; }
.result-banner { background: #f0eafa; color: #7956c0; padding: 22rpx; border-radius: 22rpx; text-align: center; margin-bottom: 22rpx; }
.speech-card { text-align: center; }
.timer { width: 180rpx; height: 180rpx; line-height: 180rpx; border-radius: 50%; margin: 25rpx auto; border: 5rpx solid #b3a1ec; font-size: 64rpx; font-weight: 750; color: #7655ce; }
.explode-button { margin-top: 24rpx; width: 100%; }
.leave { background: transparent; color: #93879f; font-size: 23rpx; margin-top: 18rpx; }
.broadcast-select { width: 100%; min-width: 0; padding: 0 16rpx; box-sizing: border-box; white-space: nowrap; font-size: 26rpx; margin-top: 20rpx; }
